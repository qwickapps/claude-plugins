{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(ls ~/.claude/plugins/cache/qwickapps-plugins/ux-design/*/hooks/enforce-framework-usage.sh 2>/dev/null | sort -V | tail -1); [ -n \"$f\" ] && bash \"$f\" || exit 0'"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(ls ~/.claude/plugins/cache/qwickapps-plugins/ux-design/*/hooks/enforce-framework-usage.sh 2>/dev/null | sort -V | tail -1); [ -n \"$f\" ] && bash \"$f\" || exit 0'"
          }
        ]
      },
      {
        "matcher": "MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'f=$(ls ~/.claude/plugins/cache/qwickapps-plugins/ux-design/*/hooks/enforce-framework-usage.sh 2>/dev/null | sort -V | tail -1); [ -n \"$f\" ] && bash \"$f\" || exit 0'"
          }
        ]
      }
    ]
  }
}
